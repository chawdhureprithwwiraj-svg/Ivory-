<?xml version="1.0" encoding="utf-8"?>
<!-- The first screen of Ivory: cream, like the house, never black,
     and CC.203: the wordmark itself, centred, on every Android version.
     A window background is never masked or clipped by the system. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="#FFFAF5E9" />
    </item>
    <item
        android:width="300dp"
        android:height="300dp"
        android:gravity="center"
        android:drawable="@drawable/splash_wordmark" />
</layer-list>
<!-- END OF FILE - android_res/drawable/launch_background.xml -->
